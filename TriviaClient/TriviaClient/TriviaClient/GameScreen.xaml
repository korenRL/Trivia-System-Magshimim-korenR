<Page x:Class="TriviaClient.GameScreen"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TriviaClient"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GameScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="QuestionsLeftText" Grid.Column="0" FontSize="18" FontWeight="Bold" Foreground="DarkBlue" HorizontalAlignment="Left" Text="Questions Left: 0" />
            <TextBlock x:Name="CorrectAnswersText" Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="Green" HorizontalAlignment="Center" Text="Correct: 0" />
            <TextBlock x:Name="TimeLeftText" Grid.Column="2" FontSize="18" FontWeight="Bold" Foreground="Red" HorizontalAlignment="Right" Text="Time: 0s" />
        </Grid>

        <TextBlock x:Name="QuestionText" Grid.Row="1" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Text="Loading Question..." />

        <UniformGrid Grid.Row="2" Rows="2" Columns="2" Height="150" Margin="0,20,0,0">
            <Button x:Name="Answer1" FontSize="18" Margin="5" Click="Answer_Click" Background="#e0e0e0"/>
            <Button x:Name="Answer2" FontSize="18" Margin="5" Click="Answer_Click" Background="#e0e0e0"/>
            <Button x:Name="Answer3" FontSize="18" Margin="5" Click="Answer_Click" Background="#e0e0e0"/>
            <Button x:Name="Answer4" FontSize="18" Margin="5" Click="Answer_Click" Background="#e0e0e0"/>
        </UniformGrid>
    </Grid>
</Page>