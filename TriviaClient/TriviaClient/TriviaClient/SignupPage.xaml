<Page x:Class="TriviaClient.SignupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="Signup" FontSize="28" FontWeight="Bold" Margin="0,0,0,25"/>

            <TextBlock Text="Username"/>
            <TextBox x:Name="UsernameBox" Margin="0,0,0,10"/>

            <TextBlock Text="Password"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10"/>

            <TextBlock Text="Email"/>
            <TextBox x:Name="EmailBox" Margin="0,0,0,15"/>

            <Button Content="Signup" Height="36" Click="Signup_Click"/>
            <Button Content="Back to Login" Height="36" Margin="0,10,0,0" Click="Back_Click"/>

            <TextBlock x:Name="StatusText" Margin="0,20,0,0" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Page>