<Page x:Class="TriviaClient.AfterGamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="25">
    <StackPanel>
        <TextBlock Text="Game Results" FontSize="28" FontWeight="Bold" Margin="0,0,0,25"/>
        <ListBox x:Name="ResultsList" Height="300" Margin="0,0,0,20"/>
        <Button Content="Back to Menu" Height="36" Click="Back_Click" Background="#f0f0f0"/>
    </StackPanel>
    </Grid>
</Page>
