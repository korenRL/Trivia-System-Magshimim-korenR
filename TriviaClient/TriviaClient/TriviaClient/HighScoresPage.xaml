<Page x:Class="TriviaClient.HighScoresPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="High Scores" FontSize="40" FontWeight="Bold" Margin="0,0,0,25" HorizontalAlignment="Center"/>

            <ListBox x:Name="ScoresList" Height="250"/>

            <Button Content="Refresh" Height="36" Margin="0,15,0,0" Click="Refresh_Click" Background="#f0f0f0"/>
            <Button Content="Back to Menu" Height="36" Margin="0,10,0,0" Click="Back_Click" Background="#f0f0f0"/>

            <TextBlock x:Name="StatusText" Margin="0,15,0,0" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Page>