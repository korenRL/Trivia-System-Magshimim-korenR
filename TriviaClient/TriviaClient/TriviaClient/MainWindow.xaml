<Window x:Class="TriviaClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trivia - Login" Height ="350" Width ="450"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <StackPanel Width="260" VerticalAlignment="Center" HorizontalAlignment="Center" >
            <TextBlock Text="Trivia Login"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <TextBlock Text="Username"/>
            <TextBox x:Name="UsernameBox"
                     Height="30"
                     Margin="0,5,0,15"/>

            <TextBlock Text="Password"/>
            <PasswordBox x:Name="PasswordBox"
                         Height="30"
                         Margin="0,5,0,20"/>

            <Button x:Name="LoginButton"
                    Content="Login"
                    Height="35"
                    Margin="0,0,0,10"/>

            <Button x:Name ="GoToSignupButton"
                    Content="Create new account"
                    Height="35"/>
        </StackPanel>
    </Grid>
</Window>