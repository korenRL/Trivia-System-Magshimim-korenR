<Page x:Class="TriviaClient.JoinRoom"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TriviaClient"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="JoinRoom">

    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="JOIN ROOM" FontSize="28" FontWeight="Bold" Margin="0,0,0,25" Foreground="Blue" />

            <TextBlock Text="Active Rooms:" Foreground="Blue" FontSize="20" Margin="0,0,0,10" />

            <ListBox x:Name="RoomsList" Height="200" Margin="0,0,0,15" Background="#f9f9f9" BorderBrush="LightGray" />

            <Button Content="Join" Height="36" Margin="0,0,0,10" Click="Join_Click" Background="#f0f0f0"/>
            <Button Content="Back" Height="36" Click="Back_Click" Background="#f0f0f0"/>

            <TextBlock x:Name="StatusText" Margin="0,20,0,0" Foreground="Red" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Page>