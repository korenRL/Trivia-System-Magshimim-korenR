<Page x:Class="TriviaClient.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="Login" FontSize="50" FontWeight="Bold" Margin="0,0,0,25" HorizontalAlignment="Center" Foreground="Black"/>

            <TextBlock Text="Username"/>
            <TextBox x:Name="UsernameBox" Margin="0,0,0,10"/>

            <TextBlock Text="Password"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,15"/>

            <Button Content="Login" Height="36" Click="Login_Click" Background="#f2f2f2"/>
            <Button Content="Go to Signup" Height="36" Margin="0,10,0,0" Click="GoSignup_Click"/>

            <TextBlock x:Name="StatusText" Margin="0,20,0,0" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Page>