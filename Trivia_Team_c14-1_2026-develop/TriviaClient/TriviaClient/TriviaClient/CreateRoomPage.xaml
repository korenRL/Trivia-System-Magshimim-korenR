<Page x:Class="TriviaClient.CreateRoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="25">
    <StackPanel>
        <TextBlock Text="Create Room" FontSize="28" FontWeight="Bold" Margin="0,0,0,25"/>

        <TextBlock Text="Room Name"/>
        <TextBox x:Name="RoomNameBox" Margin="0,0,0,10"/>

        <TextBlock Text="Max Players"/>
        <TextBox x:Name="MaxPlayersBox" Margin="0,0,0,10"/>

        <TextBlock Text="Number of Questions"/>
        <TextBox x:Name="QuestionsCountBox" Margin="0,0,0,10"/>

        <TextBlock Text="Time Per Question (seconds)"/>
        <TextBox x:Name="TimePerQuestionBox" Margin="0,0,0,15"/>

        <Button Content="Create" Height="36" Click="Create_Click" Background="#f0f0f0"/>
        <Button Content="Back" Height="36" Margin="0,10,10,0" Click="Back_Click" Background="#f0f0f0"/>

        <TextBlock x:Name="StatusText" Margin="0,20,0,0" FontWeight="Bold"/>
    </StackPanel>
    </Grid>
</Page>